{
    "name": "hems service workshop",
    "esdl_type" : "EConnection",
    "description" : "The hems model you will on during the workshop",
    "relevant_links" : [
        {
            "name" : "EConnection ESDL documentation",
            "url" : "https://energytransition.github.io/#router/doc-content/687474703a2f2f7777772e746e6f2e6e6c2f6573646c/EConnection.html",
            "description" : "Details on the EConnection ESDL type"
        }
    ],
    "calculations" : [
        {
            "name": "optimize consumption",
            "description" : "function to optimize consumption",
            "time_period_in_seconds" : 900,
            "offset_in_seconds" : 0,
            "inputs" : [
                {
                    "name" : "current_active_power",
                    "esdl_type" : "ElectricityDemand",
                    "data_type" : "DOUBLE",
                    "description" : "The current active power demand",
                    "unit" : "W"
                },
                {
                    "name" : "current_reactive_power",
                    "esdl_type" : "ElectricityDemand",
                    "data_type" : "DOUBLE",
                    "description" : "The current reactive power demand",
                    "unit" : "VAr"
                },
                {
                    "name" : "pv_active_power",
                    "esdl_type" : "PVInstallation",
                    "data_type" : "DOUBLE",
                    "description" : "The current active power production from the PV",
                    "unit" : "W"
                },
                {
                    "name" : "max_charge_active_power",
                    "esdl_type" : "Battery",
                    "data_type" : "DOUBLE",
                    "description" : "The current amount of active power the battery can maximal charge",
                    "unit" : "W"
                },
                {
                    "name" : "max_discharge_active_power",
                    "esdl_type" : "Battery",
                    "data_type" : "DOUBLE",
                    "description" : "The current amount of active power the battery can maximal discharge",
                    "unit" : "W"
                },
                {
                    "name" : "day_ahead_price",
                    "esdl_type" : "EnergyMarket",
                    "data_type" : "DOUBLE",
                    "description" : "The current market price",
                    "unit" : "EUR/MWh"
                }
            ],
            "outputs" : [
                {
                    "name" : "aggregated_active_power",
                    "data_type" : "DOUBLE",
                    "description" : "The total active power dispatch of the house accross the 3 phases",
                    "unit" : "W"
                },
                {
                    "name" : "aggregated_reactive_power",
                    "data_type" : "DOUBLE",
                    "description" : "The total reactive power dispatch of the house accross the 3 phases",
                    "unit" : "VAr"
                },
                {
                    "name" : "active_power_to_charge",
                    "data_type" : "DOUBLE",
                    "description" : "The total ",
                    "unit" : "W"
                }
            ]
        }
    ]
}